%------------------------------------------------------------------------------%
%------------------ default, protocol agnostic, rewrite rules -----------------%
%------------------------------------------------------------------------------%

[if true] (ite true ?a ?b) => ?a.
[if false] (ite false ?a ?b) => ?b.
[implies def] (implies ?a ?b) => (ite ?a ?b true).
[if simp1] (ite ?x ?a ?a) => ?a.
[if simp2] (ite ?a ?a false) => ?a.
[if simp3] (ite ?a (ite ?a ?b ?c) ?d) => (ite ?a ?b ?d).
[if simp4] (ite ?a true false) => ?a.
[implies simp] (ite (and ?a ?b) ?a true) => true.
[implies simp2] (ite ?a ?a true) => true.
[classical not] (not (not ?a)) => ?a.
%[and symm] (and ?a ?b) => (and ?b ?a).
%[and simpl] (and ?a ?a) => ?a.
%[and assoc] (and ?a (and ?b ?c)) => (and (and ?a ?b) ?c).
[and def] (and ?a ?b) => (ite ?a ?b false). 

[not def] (not ?a) => (ite ?a false true).
[meq true] ?v1 = (meq ?a ?b), ?v1 = true => ?a = ?b.
[reverse and] ?v1 = (ite ?a ?b false), ?v1 = true => ?a = true, ?b = true.
[implies trans] ?v1 = true, ?v1 = (ite ?a ?b true), ?v1 = (ite ?b ?c true) => ?v1 = (mimplies ?a ?c).
[p1] (p1 (tuple ?a ?b)) => ?a.
[p2] (p2 (tuple ?a ?b)) => ?b.
[meq refl] (meq ?a ?a) => true.
[meq symm] (meq ?a ?b) => (meq ?b ?a).

[bif true] (b_ite true ?a ?b) => ?a.
[bif false] (b_ite false ?a ?b) => ?b.
[bif simp1] (b_ite ?x ?a ?a) => ?a.
[bif simp3] (b_ite ?a (b_ite ?a ?b ?c) ?d) => (ite ?a ?b ?d).

[unfold_exec]  (unfold_exec ?t ?p) 
  => (and (macro_cond ?t ?p) (macro_exec (pred ?t) ?p)).
[unfold_frame] (unfold_frame ?t ?p) => (tuple
  (tuple (macro_exec ?t ?p) (b_ite (macro_exec ?t ?p) (macro_msg ?t ?p) empty))
  (macro_frame (pred ?t) ?p)
).
[unfold_input] (unfold_input ?t ?p) => (att (macro_frame (pred ?t) ?p)).

[unfold macro_input]
  ?v1 = (happens ?t), ?v1 = true, ?v2 = (macro_input ?t ?p) =>
  ?v2 = (unfold_input ?t ?p).

[unfold macro_exec]
  ?v1 = (happens ?t), ?v1 = true, ?v2 = (macro_exec ?t ?p) =>
  ?v2 = (unfold_exec ?t ?p).

[unfold macro_frame]
  ?v1 = (happens ?t), ?v1 = true, ?v2 = (macro_frame ?t ?p) =>
  ?v2 = (unfold_frame ?t ?p).

[unfold macro_msg]
  ?v1 = (happens ?t), ?v1 = true, ?v2 = (macro_msg ?t ?p) =>
  ?v2 = (unfold_msg ?t ?p).

[unfold macro_cond]
  ?v1 = (happens ?t), ?v1 = true, ?v2 = (macro_cond ?t ?p) =>
  ?v2 = (unfold_cond ?t ?p).

[leq refl] (leq ?t ?t) => true.
[leq pred] (leq (pred ?t) ?t) => true.

[happens leq]
?v1 = (happens ?t), ?v1 = (leq ?t2 ?t1), ?v1 = true => ?v1 = (happens ?t2).