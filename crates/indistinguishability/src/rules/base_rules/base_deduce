[deduce fresh nonces]
(deduce_m ?u ?v (nonce ?x) (nonce ?y) ?h1 ?h2):-
  (fresh_nonce ?x ?u ?h1),
  (fresh_nonce ?y ?v ?h2).

[vampire trivial]
(mvampire mtrue) :- .