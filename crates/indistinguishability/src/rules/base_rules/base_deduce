[equiv axiom]
(equiv ?u ?v ?x ?x):-.
[equiv deduce]
(equiv ?u ?v ?a ?b) :-
  (deduce_m ?u ?v ?a ?b true true).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%% macros %%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

[deduce macro frame]
(deduce_m (macro_frame ?t ?p1) (macro_frame ?t ?p2) (macro_frame ?t2 ?p1) (macro_frame ?t2 ?p2) ?h1 ?h2) :-
  (vampire (implies ?h1 (leq ?t2 ?t))),
  (vampire (implies ?h2 (leq ?t2 ?t))),
  (vampire (happens ?t)).

[deduce macro input]
(deduce_m (macro_frame ?t ?p1) (macro_frame ?t ?p2) (macro_input ?t2 ?p1) (macro_input ?t2 ?p2) ?h1 ?h2) :-
  (vampire (implies ?h1 (leq ?t2 ?t))),
  (vampire (implies ?h2 (leq ?t2 ?t))),
  (vampire (happens ?t)).

[deduce macro msg]
(deduce_m (macro_frame ?t ?p1) (macro_frame ?t ?p2) (macro_msg ?t2 ?p1) (macro_msg ?t2 ?p2) ?h1 ?h2) :-
  (vampire (implies ?h1 (leq ?t2 ?t))),
  (vampire (implies ?h2 (leq ?t2 ?t))),
  (vampire (happens ?t)).

[deduce macro exec]
(deduce_b (macro_frame ?t ?p1) (macro_frame ?t ?p2) (macro_exec ?t2 ?p1) (macro_exec ?t2 ?p2) ?h1 ?h2) :-
  (vampire (implies ?h1 (leq ?t2 ?t))),
  (vampire (implies ?h2 (leq ?t2 ?t))),
  (vampire (happens ?t)).

[deduce macro cond]
(deduce_b (macro_frame ?t ?p1) (macro_frame ?t ?p2) (macro_cond ?t2 ?p1) (macro_cond ?t2 ?p2) ?h1 ?h2) :-
  (vampire (implies ?h1 (leq ?t2 ?t))),
  (vampire (implies ?h2 (leq ?t2 ?t))),
  (vampire (happens ?t)).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%% ite %%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

[deduce b_ite]
(deduce_b ?u ?v (b_ite ?a1 ?b1 ?c1) (b_ite ?a2 ?b2 ?c2) ?h1 ?h2) :-,
  (deduce_b ?u ?v ?b1 ?b2 (and ?a1 ?h1) (and ?a2 ?h2)),
  (deduce_b ?u ?v ?c1 ?c2 (and (not ?a1) ?h1) (and (not ?a2) ?h2)),
  (deduce_b ?u ?v ?a1 ?a2 ?h1 ?h2).

[deduce ite]
(deduce_m ?u ?v (ite ?a1 ?b1 ?c1) (ite ?a2 ?b2 ?c2) ?h1 ?h2) :-,
  (deduce_m ?u ?v ?b1 ?b2 (and ?a1 ?h1) (and ?a2 ?h2)),
  (deduce_m ?u ?v ?c1 ?c2 (and (not ?a1) ?h1) (and (not ?a2) ?h2)),
  (deduce_b ?u ?v ?a1 ?a2 ?h1 ?h2).

