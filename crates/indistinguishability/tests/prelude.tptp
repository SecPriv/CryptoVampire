fof(if_def, hypothesis,  mite(X, Y, Z) = ite(X, Y, Z)).
%fof(implies_def, hypothesis,  (A => B) <=>implies(A, B)).
fof(not_def, hypothesis,  mnot(X) = not(X)).

fof(and, hypothesis, mand(X, Y) <=> ( X & Y)).

fof(p1, hypothesis,  p1(tuple(X, Y)) = X).
fof(p2, hypothesis,  p2(tuple(X, Y)) = Y).

fof(meq, hypothesis,  meq(X, Y) <=> (X = Y)).

fof(leq1, hypothesis,  leq(X, X)).
fof(leq2, hypothesis,  leq(pred(X), X)).
fof(leq3, hypothesis, leq(init, X)).

fof(lt, hypothesis, lt(X, Y) <=> (leq(X, Y) & X != Y)).

fof(lt2, hypothesis,
  ('T'(I1, J1) = 'T'(I2, J2)) => ((I1 = I2) & (J1 = J2))
).

fof(t1, hypothesis,
  ('T'(I1, J1) = 'T'(I2, J2)) => ((I1 = I2) & (J1 = J2))
).

fof(rs1, hypothesis,
  ('Rs'(I1, J1) = 'Rs'(I2, J2)) => ((I1 = I2) & (J1 = J2))
).

fof(rf1, hypothesis,
  ('Rf'(I1) = 'Rf'(I2)) => (I1 = I2)
).

fof(distrinc, hypothesis,
  ('T'(I1, J1) != 'Rs'(I2, J2)) & ('T'(I1, J1) != 'Rf'(J2)) & ('Rs'(I1, J2) != 'Rf'(J2))
    & ('T'(I1, J1) != init) & ('Rs'(I1, J1) != init) & ('Rf'(J1) != init)
).

