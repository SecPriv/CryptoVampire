/* @cryptovampire run: --exec-pred skip */
/*
PROOF MODEL (tool-provided exec_pred): same lak-tag add-rewrite + guarded-
bridge lemma, using the TOOL-PRODUCED `exec_pred` symbol (cryptovampire
--exec-pred) instead of any hand-written pred_exec! / pred_exec. Preferred way to
get a named exec predicate.

HOW TO RUN:
    cryptovampire lak-tag-add-rewrite-execpred.ptcl --exec-pred --pairwise-find-fa auto -l --timeout 15
  Requires BOTH --exec-pred and --pairwise-find-fa -l. Rerun on "ran out of
  tries" (nondeterministic).
*/
type index;

fun tpl(Message, Message):Message

fun sel1of2(Message):Message;
fun sel2of2(Message):Message
fun hash(Message, Message):Message
fun verify(Message, Message, Message):Bool

fun ok:Message
fun ko:Message
fun tag1:Message
fun tag2:Message

/* the Names */
fun nt(index, index): Name
fun nr(index): Name

/* one-index key (protocol p1) */
fun key(index):Name
let mkey!(i:index, k:index) = key(i)

/* mk-fdst1's search condition, in verify-form (euf-cma), scm writes
   eq (sel2of2 in) (mhash (tuple (tuple (nr j) (sel1of2 in)) tag1) (mk i k)). */
let m_condition_fst!(i:index, j:index, k:index, m_in: Message) =
    verify(
        sel2of2(m_in),
        tpl(tpl(nr(j), sel1of2(m_in)), tag1),
        mkey!(i, k))

step reader1(i:index)
    { true }
    { nr(i) }

/* mk-fdst1: the real reader, applied at its own index j (no stray index). */
step reader2(j:index)
    { true }
    {
        try find (i:index, k:index)
            such that { m_condition_fst!(i, j, k, input(reader2(j))) }
            then { hash(
                tpl(tpl(nr(j), sel1of2(input(reader2(j)))), tag2),
                mkey!(i, k)) }
            else { ko }
    }

step tag(i:index, k:index)
    { true }
    { tpl(
        nt(i,k),
        hash(tpl(tpl(input(tag(i,k)), nt(i,k)), tag1), mkey!(i, k))
    )}

assert
    forall (m1:Message, m2:Message) {
        (
            (m1 == sel1of2(tpl(m1,m2)))
            && (m2 == sel2of2(tpl(m1,m2)))
        )
    }
assert
    forall (m1:Message, m2:Message, m3:Message, m4:Message) {
        (
            (tpl(m1,m2) == tpl(m3, m4))
                => (
                    (m1 == m3)
                    && (m2 == m4)
                )
        )
    }

assert
    forall (s:Message, m:Message, k:Message) {
        (verify(s, m, k) <=> (s == hash(m, k)))
    }

assert (ko != ok)
assert (tag1 != tag2)

order forall (j:index)
    reader1(j) < reader2(j)


/* mk-fdst2: the idealized/honest find. Search condition = the honest
   transcript (sel1/sel2 match + exec + orderings + input(tag)==msg(r1)). */
let fdst2!(j:index) =
    try find (i:index, k:index)
        such that { (
        (input(tag(i,k)) == msg!(reader1(j)))
        && (sel1of2(input(reader2(j))) == sel1of2(msg!(tag(i,k))))
        && (sel2of2(input(reader2(j))) == sel2of2(msg!(tag(i,k))))
        && exec_pred(reader2(j))
        && s_lt(reader1(j), tag(i,k))
        && s_lt(tag(i,k), reader2(j))
        ) }
        then { hash(
            tpl(tpl(nr(j), sel1of2(input(reader2(j)))), tag2),
            mkey!(i, k)) }
        else { ko }

/* Guarded bridge, one-index (p1): `key(i)` depends only on the session index
   `i`; the honest transcript's *row* index `k` is invisible on the decrypt
   side (the `m_condition_fst!` macro drops it). Split into the two directed
   clauses that mirror the pairwise-find-fa bridge ("fa pairs") exactly:
     forward  forall j i.    exec_pred(reader2 j) => (decrypt(j,i) => exists k. honest)
     backward forall j i k.  exec_pred(reader2 j) => (honest => decrypt(j,i))
   with `honest` the fdst2 search condition spelled with `s_lt`, term-for-term
   equal to `fdst2!` (except the macro-dropped row index), so each clause
   discharges its fa half. */
lemma forall (j:index, i:index) {(
    exec_pred(reader2(j))
    =>
    (
        verify(
            sel2of2(input(reader2(j))),
            tpl(
                tpl(
                    nr(j),
                    sel1of2(input(reader2(j)))
                ),
                tag1
            ),
            key(i)
        )
        =>
        exists (k:index) {(
            (input(tag(i,k)) == msg!(reader1(j)))
            && (sel1of2(input(reader2(j))) == sel1of2(msg!(tag(i,k))))
            && (sel2of2(input(reader2(j))) == sel2of2(msg!(tag(i,k))))
            && exec_pred(reader2(j))
            && s_lt(reader1(j), tag(i,k))
            && s_lt(tag(i,k), reader2(j))
        )}
    )
)}

lemma forall (j:index, i:index, k:index) {(
    exec_pred(reader2(j))
    =>
    (
        (
            (input(tag(i,k)) == msg!(reader1(j)))
            && (sel1of2(input(reader2(j))) == sel1of2(msg!(tag(i,k))))
            && (sel2of2(input(reader2(j))) == sel2of2(msg!(tag(i,k))))
            && exec_pred(reader2(j))
            && s_lt(reader1(j), tag(i,k))
            && s_lt(tag(i,k), reader2(j))
        )
        =>
        verify(
            sel2of2(input(reader2(j))),
            tpl(
                tpl(
                    nr(j),
                    sel1of2(input(reader2(j)))
                ),
                tag1
            ),
            key(i)
        )
    )
)}
/* The add-rewrite: at an executing reader2(j), the reader's output (mk-fdst1)
   equals the idealized output (mk-fdst2). */
query forall (j:index) {(
    if (exec_pred(reader2(j)) && cond!(reader2(j))) { msg!(reader2(j)) } else {empty}
    ==
    if (exec_pred(reader2(j)) && cond!(reader2(j))) { fdst2!(j) } else {empty}
)}

assert-crypto euf-cma hash verify;
assert-crypto nonce;
